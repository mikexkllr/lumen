<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lumen – iOS privacy manifest TEMPLATE.
  After `npx cap add ios`, copy this file to ios/App/App/PrivacyInfo.xcprivacy and
  add it to the "App" target in Xcode (File > Add Files…, target membership: App).
  Keep it in sync with the App Privacy answers in App Store Connect (docs/store-release.md).

  What it declares (only data that leaves the device; everything else stays local in the WebView):
  - Product interaction: learning events (attempts, XP, days) – only if the user turns on sync
    or social features; stored under a random account id, no e-mail, no device id.
  - User ID: random account id plus the optional social handle.
  - Name: the optional social display name (free text, may be a real name).
  - Other user content: Lux tutor messages (processed by the server's language model, not stored
    by Lumen) and social interactions (friend list, fixed-emoji reactions, reports).
  None of it is used for tracking, advertising or analytics, and there are no tracking domains.

  Required-reason APIs: Lumen's own code is web code and calls none. WebView storage
  (localStorage, IndexedDB) is not a required-reason API. UserDefaults (CA92.1 = only the
  app's own data) is declared conservatively for Capacitor and its plugins; Capacitor and
  its plugins also ship their own manifests. Verify with Xcode: Product > Archive >
  (right-click the archive) Generate Privacy Report, and adjust before submission.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
