{
  "name": "@lumen/mobile",
  "version": "1.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Capacitor shell that packages the Lumen PWA (apps/web) as iOS and Android apps.",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.ts",
    "sync": "npm run build:web && cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
