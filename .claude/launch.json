{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lumen-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@lumen/web", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "lumen-server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/server/src/main.ts"],
      "port": 8787
    },
    {
      "name": "lumen-server-mail-log",
      "runtimeExecutable": "env",
      "runtimeArgs": ["LUMEN_MAIL_LOG=1", "node", "apps/server/src/main.ts"],
      "port": 8787
    },
    {
      "name": "lumen-server-google",
      "runtimeExecutable": "env",
      "runtimeArgs": ["LUMEN_MAIL_LOG=1", "LUMEN_GOOGLE_WEB_CLIENT_ID=955817471753-qbf7djglidhtbkab7qhl33ppr1ka1lfk.apps.googleusercontent.com", "node", "apps/server/src/main.ts"],
      "port": 8787
    }
  ]
}
