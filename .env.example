# Lumen configuration for docker-compose.prod.yml (copy to .env and edit).
# .env is in .gitignore – it holds secrets, never commit it.
#
# Rules: leave optional settings commented out instead of setting them to an empty
# value. VITE_* values are baked into the public web bundle at build time (rebuild with
# `--build` after changing them) – never put secrets into VITE_* variables.

# ── Domain and HTTPS (Caddy) ────────────────────────────────────────────────
# Public hostname; its DNS A/AAAA records must point to this server.
LUMEN_DOMAIN=lumen.example.org
# Contact address for Let's Encrypt (expiry warnings).
LUMEN_ACME_EMAIL=admin@example.org

# ── Web app (build time) ────────────────────────────────────────────────────
# Base URL of the Lumen server API. Default /api (same origin, routed by Caddy).
# Native apps are built separately with an absolute URL (apps/mobile/README.md).
#VITE_LUMEN_API_URL=/api

# Operator details for the in-app legal pages (#/legal/privacy, #/legal/terms,
# #/legal/imprint). Required for a public deployment and for the app stores.
VITE_LUMEN_OPERATOR=Erika Mustermann
# Postal address; single quotes keep "\n" as a line-break marker.
VITE_LUMEN_OPERATOR_ADDRESS='Musterstraße 1\n12345 Musterstadt\nDeutschland'
VITE_LUMEN_CONTACT=kontakt@example.org
VITE_LUMEN_PHONE=
VITE_LUMEN_VAT_ID=

# Ed25519 public key for signed content bundles (see README → Signed content bundles).
#VITE_LUMEN_PUBLIC_KEY=
# "Report a problem" opens a prefilled issue here instead of copying the text,
# e.g. https://github.com/<owner>/<repo>/issues/new
#VITE_LUMEN_ISSUES_URL=

# Content-Security-Policy connect-src (default 'self' https:). Learners can pick another
# Lumen server and bring their own AI key (requests go from the browser straight to the
# provider), so any https origin is allowed. Lock it down to 'self' to disable both on
# the website (the store apps are not affected).
#LUMEN_CSP_CONNECT_SRC="'self'"

# ── Server ──────────────────────────────────────────────────────────────────
# Allowed browser origins (comma-separated). Default: https://${LUMEN_DOMAIN} plus the
# native app origins capacitor://localhost (iOS) and https://localhost (Android).
#LUMEN_CORS_ORIGINS=https://lumen.example.org,capacitor://localhost,https://localhost
# Requests per minute and IP (all endpoints).
#LUMEN_RATE_LIMIT=120

# Social features (profiles, friends, leagues, feed). Set to off to disable them.
#LUMEN_SOCIAL=off
# Enables the moderation endpoints /api/v1/admin/* (reports, bans). Use a long random
# secret, e.g. `openssl rand -hex 32`. Without it the admin endpoints are disabled.
#LUMEN_ADMIN_TOKEN=

# ── Lux tutor (language model) ──────────────────────────────────────────────
# Without a model, Lux answers with the built-in rule tutor. Remove this line once a
# model is configured below.
LUMEN_TUTOR=off
# Any OpenAI-compatible endpoint, e.g. OpenRouter:
#LUMEN_TUTOR_URL=https://openrouter.ai/api/v1
#LUMEN_TUTOR_MODEL=qwen/qwen3-30b-a3b
#LUMEN_TUTOR_API_KEY=
# Provider name shown in the app before learners consent to the model (default: the API host):
#LUMEN_TUTOR_PROVIDER=OpenRouter
# Optional tuning (defaults shown):
#LUMEN_TUTOR_REASONING=
#LUMEN_TUTOR_MAX_TOKENS=220
#LUMEN_TUTOR_TEMPERATURE=0.3
#LUMEN_TUTOR_TIMEOUT_MS=20000
#LUMEN_TUTOR_RATE_LIMIT=30

# ── Backups (deploy/backup.sh) ──────────────────────────────────────────────
#LUMEN_BACKUP_DIR=./backups
#LUMEN_BACKUP_KEEP=14
