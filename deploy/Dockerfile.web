# Website + PWA: build content bundles and the app (served at /app/), serve with nginx.
FROM node:26-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps ./apps
RUN npm ci
COPY content ./content
COPY site ./site
COPY scripts/build-site.ts ./scripts/
COPY tsconfig.base.json tsconfig.json ./
ARG VITE_LUMEN_SYNC_URL=""
ARG VITE_LUMEN_PUBLIC_KEY=""
ARG LUMEN_SITE_ORIGIN=""
ENV VITE_LUMEN_SYNC_URL=$VITE_LUMEN_SYNC_URL VITE_LUMEN_PUBLIC_KEY=$VITE_LUMEN_PUBLIC_KEY LUMEN_BASE=/app/
RUN npm run build && if [ -n "$LUMEN_SITE_ORIGIN" ]; then LUMEN_SITE_ORIGIN=$LUMEN_SITE_ORIGIN node scripts/build-site.ts; fi

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/site /usr/share/nginx/html
COPY --from=build /src/apps/web/dist /usr/share/nginx/html/app
EXPOSE 80
