# Lumen web container: serves the static PWA and proxies /api/ to the Lumen server.
# This is an nginx *template*: at container start the official nginx image runs envsubst
# on it (only LUMEN_* variables, see NGINX_ENVSUBST_FILTER in deploy/Dockerfile.web).
#   LUMEN_API_UPSTREAM     Lumen server base URL           default http://sync:8787
#   LUMEN_DNS_RESOLVER     resolver for the upstream name  default 127.0.0.11 (Docker DNS)
#   LUMEN_CSP_CONNECT_SRC  CSP connect-src sources         default 'self' https:

# Cache policy per request path. add_header with an empty value adds nothing, so
# API responses keep the server's own Cache-Control: no-store.
map $request_uri $lumen_cache_control {
  ~^/api/                    "";
  ~^/content/manifest\.json  "no-cache";
  ~^/(assets|content)/       "public, max-age=31536000, immutable";
  default                    "no-cache";
}

server {
  listen 80;
  server_tokens off;
  absolute_redirect off;
  root /usr/share/nginx/html;
  charset utf-8;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml text/plain;

  # All headers live here (server level): a location with its own add_header would drop them.
  # CSP: same-origin scripts only (no inline/eval); 'unsafe-inline' styles are needed for
  # KaTeX's inline style attributes; data: covers small inline images and fonts.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; connect-src ${LUMEN_CSP_CONNECT_SRC}; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;
  add_header Cross-Origin-Opener-Policy same-origin always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
  add_header Cache-Control $lumen_cache_control;

  # Lumen server (sync, Lux tutor, social) under /api, prefix stripped like the Vite dev proxy.
  # The upstream is a variable, so nginx starts even when the server is not (yet) running;
  # /api then answers 502 and the app keeps working offline.
  location /api/ {
    resolver ${LUMEN_DNS_RESOLVER} valid=30s ipv6=off;
    resolver_timeout 5s;
    set $lumen_api ${LUMEN_API_UPSTREAM};
    rewrite ^/api(/.*)$ $1 break;
    proxy_pass $lumen_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # overwrite (not append) so clients cannot spoof the IP used for rate limiting
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    client_max_body_size 5m;
    # the server sets its own; avoid sending it twice
    proxy_hide_header X-Content-Type-Options;
  }

  location = /manifest.webmanifest { default_type application/manifest+json; types { } }

  # hashed bundles and assets: a missing file is a 404, never the app shell
  location /assets/ { try_files $uri =404; }
  location /content/ { try_files $uri =404; }
  location / { try_files $uri /index.html; }
}
