# Same image as deploy/Dockerfile.web, but from a site and app built on the dev machine
# (the 1 vCPU / 2 GB VPS has too little memory for the Vite build). See deploy/vps/deploy.sh.
FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY site /usr/share/nginx/html
COPY apps/web/dist /usr/share/nginx/html/app
EXPOSE 80
