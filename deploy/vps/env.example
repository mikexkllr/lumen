# /opt/sites/lumen/.env – server only, never commit the real file.
LUMEN_CORS_ORIGINS=https://lumen.mikekeller.cloud
# Lux: rule tutor until a model is configured. For OpenRouter remove LUMEN_TUTOR=off and set:
#   LUMEN_TUTOR_URL=https://openrouter.ai/api/v1
#   LUMEN_TUTOR_MODEL=<model id>
#   LUMEN_TUTOR_API_KEY=<key>
# (update site/datenschutz.html section 5 before switching on an external model)
LUMEN_TUTOR=off
