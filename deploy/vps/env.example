# /opt/sites/lumen/.env on the VPS (chmod 600, never commit the real file).
# Server settings are read by the lumen-sync container; VITE_* lines are public build-time
# values that deploy.sh reads from here when it builds the web app (never secrets in VITE_*).
# Full reference: .env.example in the repository root.

# ── Web app (build time, public) ────────────────────────────────────────────
VITE_LUMEN_API_URL=/api
VITE_LUMEN_OPERATOR=Erika Mustermann
VITE_LUMEN_OPERATOR_ADDRESS='Musterstraße 1\n12345 Musterstadt\nDeutschland'
VITE_LUMEN_CONTACT=kontakt@example.org
# optional, shown in the imprint
VITE_LUMEN_PHONE=
VITE_LUMEN_VAT_ID=
VITE_LUMEN_ISSUES_URL=https://github.com/mikexkllr/lumen/issues/new
# crash reports of the web app (public DSN of a Sentry project); empty: none
VITE_SENTRY_DSN=

# ── Server ──────────────────────────────────────────────────────────────────
LUMEN_CORS_ORIGINS=https://lumen.mikekeller.cloud,capacitor://localhost,https://localhost
# moderation endpoints /api/v1/admin/* – `openssl rand -hex 32`
LUMEN_ADMIN_TOKEN=
# Sign-in on new devices (optional): email codes, Sign in with Apple and Sign in with Google
LUMEN_SMTP_URL=
LUMEN_MAIL_FROM=
LUMEN_EMAIL_PEPPER=
# Store review login (Google Play / App Store reviewers): this address gets no mail and
# signs in with the fixed six-digit code; give both to the store under App access.
LUMEN_REVIEW_EMAIL=
LUMEN_REVIEW_CODE=
LUMEN_APPLE_CLIENT_IDS=
LUMEN_APPLE_TEAM_ID=
LUMEN_APPLE_KEY_ID=
LUMEN_APPLE_PRIVATE_KEY=
# Sign in with Google: public OAuth client ids from Google Cloud (project lumen-play-mk,
# Google Auth Platform → Clients); the web client also serves Android (Credential Manager)
LUMEN_GOOGLE_WEB_CLIENT_ID=
LUMEN_GOOGLE_IOS_CLIENT_ID=

# Crash reports of the server (Sentry DSN); empty: none
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Lux (OpenRouter) ────────────────────────────────────────────────────────
LUMEN_TUTOR_URL=https://openrouter.ai/api/v1
LUMEN_TUTOR_MODEL=deepseek/deepseek-v4.1-flash-1017
LUMEN_TUTOR_API_KEY=
LUMEN_TUTOR_PROVIDER=OpenRouter
# DeepSeek V4.1 Flash answers well without thinking tokens (fastest, cheapest). Reasoning
# models such as gpt-oss need "low" instead – otherwise they spend max_tokens thinking.
LUMEN_TUTOR_REASONING=none
LUMEN_TUTOR_MAX_TOKENS=400
