{
  "name": "lumen",
  "private": true,
  "version": "0.1.0",
  "description": "Lumen \u2013 freie, offene Lern-App f\u00fcr MINT: interaktive Aufgaben, sofortiges Feedback, Spaced Repetition.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node packages/cli/src/cli.ts check content",
    "build:content": "node packages/cli/src/cli.ts build content --out apps/web/public/content",
    "dev": "node packages/cli/src/cli.ts dev",
    "build": "npm run build:content && npm run build -w @lumen/web",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "server": "node apps/server/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}