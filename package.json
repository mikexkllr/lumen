{
  "name": "lumen",
  "private": true,
  "version": "0.1.0",
  "description": "Lumen – a free alternative to Brilliant.org: open-source learning app for STEM with interactive problems, instant feedback, an AI tutor and spaced repetition.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node packages/cli/src/cli.ts check content && node packages/cli/src/cli.ts check content --locale en",
    "build:content": "node packages/cli/src/cli.ts build content --out apps/web/public/content",
    "dev": "node packages/cli/src/cli.ts dev",
    "build": "npm run build:content && npm run build -w @lumen/web",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "server": "node apps/server/src/main.ts",
    "build:e2e": "VITE_LUMEN_E2E=1 npm run build",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
